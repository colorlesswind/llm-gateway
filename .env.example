# 复制为 .env 后填入真实值：cp .env.example .env
#
# 注意：.env 会同时被 pydantic-settings 和 docker compose 读取。
# 容器部署时建议的数据库路径是 sqlite:////data/llm_gateway.db（挂载卷），
# 本地开发用相对路径即可；docker-compose.yml 默认已把容器内的路径改好，
# 需要覆盖时用 GATEWAY_DATABASE_URL。

# --- 模型选择 ---------------------------------------------------------------
MODEL_CHAIN=deepseek-chat,gpt-4o-mini
ENABLE_RESPONSES_MODE=false

# --- DeepSeek（OpenAI 兼容，chat） -----------------------------------------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MODEL_DEEPSEEK_CHAT_PROVIDER=deepseek
MODEL_DEEPSEEK_CHAT_UPSTREAM=deepseek-chat
MODEL_DEEPSEEK_CHAT_MODE=chat

# --- OpenAI（responses 或 chat） -------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_GPT_4O_MINI_PROVIDER=openai
MODEL_GPT_4O_MINI_UPSTREAM=gpt-4o-mini
MODEL_GPT_4O_MINI_MODE=chat

# --- 超时（秒） -------------------------------------------------------------
CONNECT_TIMEOUT=10
READ_TIMEOUT=60
FIRST_TOKEN_TIMEOUT=20
IDLE_TIMEOUT=60

# --- 重试 / 熔断 ------------------------------------------------------------
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=0.5
RETRY_MAX_DELAY=8
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN=30

# --- 入口限流（进程内计数） -------------------------------------------------
MAX_CONCURRENT_REQUESTS=10
OVERLOAD_RETRY_AFTER=1

# --- 结构化输出 -------------------------------------------------------------
STRUCTURED_OUTPUT_ENABLED=true
SCHEMA_REPAIR_MAX_ATTEMPTS=2
SCHEMA_REPAIR_MAX_ERROR_CHARS=2000
SCHEMA_REPAIR_MAX_OUTPUT_CHARS=4000
SCHEMA_MAX_BYTES=16384
SCHEMA_MAX_DEPTH=12
SCHEMA_REPAIR_ON_LENGTH=false
SCHEMA_SUM_USAGE=true
SCHEMAS_DIR=schemas

# --- 提示词模板存储 ---------------------------------------------------------
# 本地开发：sqlite:///./llm_gateway.db
# 容器内：  sqlite:////data/llm_gateway.db
# PostgreSQL：postgresql+psycopg://user:pw@host:5432/llm_gateway（需另装 psycopg[binary]）
DATABASE_URL=sqlite:///./llm_gateway.db
